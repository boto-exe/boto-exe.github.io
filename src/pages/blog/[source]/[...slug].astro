---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Article from '../../../components/Article.astro';
import { sources } from '../../../lib/posts';

export async function getStaticPaths() {
  const htb = (await getCollection('htb')).map((post) => ({ params: { source: 'htb', slug: post.id }, props: { post, source: 'htb' } }));
  const hsm = (await getCollection('hsm')).map((post) => ({ params: { source: 'hsm', slug: post.id }, props: { post, source: 'hsm' } }));
  const series = (await getCollection('malice'))
    .filter((p) => !p.data.draft || !import.meta.env.PROD)
    .sort((a, b) => a.data.part - b.data.part);
  const malice = series.map((post, i) => ({
    params: { source: 'malice', slug: post.id },
    props: { post, source: 'malice', prev: series[i - 1], next: series[i + 1] },
  }));
  return [...htb, ...hsm, ...malice];
}
const { post, source, prev, next } = Astro.props as any;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const d = post.data;
const label = sources[source as keyof typeof sources].label;
const chips = [source === 'malice' ? `part ${d.part}` : '', d.difficulty, d.os, ...(d.tags ?? [])].filter(Boolean) as string[];
---
<Base title={`${label} : ${d.title}`} description={d.summary} type="article" date={d.date}>
  <Article title={d.title} label={label} labelClass={`src-${source}`} date={d.date} chips={chips} back={{ href: `${base}blog/`, label: 'Blog' }}>
    <Content />
    {source === 'malice' && (
      <nav slot="after" class="pager" aria-label="Series">
        <span>{prev && <a href={`${base}blog/malice/${prev.id}/`}>prev: {prev.data.title}</a>}</span>
        <span>{next && <a href={`${base}blog/malice/${next.id}/`}>next: {next.data.title}</a>}</span>
      </nav>
    )}
  </Article>
</Base>